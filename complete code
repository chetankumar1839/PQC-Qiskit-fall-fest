        "\n",
        "    def respond(self, risk):\n",
        "\n",
        "        if risk > 0.50:\n",
        "            return {\n",
        "                \"action\": \"BLOCK_AND_QUARANTINE\",\n",
        "                \"status\": \"QUARANTINED\",\n",
        "                \"message\": \"High-risk transaction blocked.\",\n",
        "                \"algorithm\": self.algorithm\n",
        "            }\n",
        "\n",

        "\n",
        "        with open(\"interface_public.key\", \"rb\") as f:\n",
        "            public_key = f.read()\n",
        "\n",
        "        with open(\"interface_signature.sig\", \"rb\") as f:\n",
        "            signature = f.read()\n",
        "\n",
        "        with oqs.Signature(\"ML-DSA-65\") as verifier:\n",
        "            valid = verifier.verify(data, signature, public_key)\n",

        "    # Measure the third qubit\n",
        "    qc.measure(2, 0)\n",
        "\n",
        "    # Qiskit Aer simulator\n",
        "    simulator = AerSimulator()\n",
        "\n",
        "    compiled_circuit = transpile(\n",
        "        qc,\n",
        "        simulator\n",
        "    )\n",
        "\n",
        "    result = simulator.run(\n",
